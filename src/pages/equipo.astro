---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import BackToTop from "../components/BackToTop.astro";
import ScrollReveal from "../components/ScrollReveal.astro";
import CtaBanner from "../components/CtaBanner.astro";
import TeamPhoto from "../components/TeamPhoto.astro";
import { PASTORAL_INTRO, PASTORAL, ADMINISTRACION, COORDINADORES } from "../lib/equipo";

// El primero es el pastor general (tarjeta destacada); el resto, los ancianos.
const [generalPastor, ...elders] = PASTORAL;

const sections = [
  { id: "cuerpo-pastoral", label: "Cuerpo Pastoral" },
  { id: "administracion", label: "Administración" },
  { id: "coordinadores", label: "Coordinadores de Ministerio" },
];
---

<Layout
  title="Nuestra esencia — Cristo Viene"
  description="Conoce al equipo de Cristo Viene: cuerpo pastoral, administración y coordinadores de ministerio."
>
  <Navbar />
  <main>
    <!-- Cabecera -->
    <section class="px-6 pt-36 pb-10 md:pt-44 md:pb-12">
      <div class="mx-auto flex max-w-6xl flex-col gap-8 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="mb-4 text-eyebrow uppercase tracking-[0.3em] text-text-secondary">
            Nuestra esencia
          </p>
          <h1 class="max-w-xl text-hero font-bold text-balance">
            Nuestro <span class="text-accent">equipo</span>
          </h1>
        </div>
        <p class="max-w-sm text-body text-text-secondary md:pb-2">
          Nos damos la mano unos a otros para servir y hacer la diferencia.
        </p>
      </div>
    </section>

    <!-- Acceso rápido a cada sección -->
    <nav aria-label="Secciones de la página" class="px-6 pb-16 md:pb-20">
      <div class="mx-auto flex max-w-6xl flex-wrap gap-3">
        {sections.map((s) => (
          <a
            href={`#${s.id}`}
            class="rounded-full border border-text-secondary/40 px-5 py-2 text-small text-text-primary transition-colors hover:border-accent hover:text-accent"
          >
            {s.label}
          </a>
        ))}
      </div>
    </nav>

    <!-- 01 · Cuerpo Pastoral -->
    <section id="cuerpo-pastoral" class="px-6 pb-20 md:pb-28">
      <div class="mx-auto max-w-6xl">
        <div data-reveal class="mb-10 grid gap-6 md:mb-14 md:grid-cols-2 md:items-end">
          <div>
            <p class="mb-4 flex items-center gap-3 text-eyebrow uppercase tracking-[0.3em] text-text-secondary">
              01 <span class="inline-block h-px w-10 bg-text-secondary/40"></span>
            </p>
            <h2 class="text-h2 font-bold text-balance">
              Cuerpo <span class="text-accent">Pastoral</span>
            </h2>
          </div>
          <p class="max-w-md text-body text-text-secondary md:justify-self-end">
            {PASTORAL_INTRO}
          </p>
        </div>

        <!-- Pastor general: tarjeta destacada -->
        <article
          data-reveal
          class="group grid overflow-hidden rounded-card bg-bg-block md:grid-cols-[2fr_3fr]"
        >
          <TeamPhoto
            src={generalPastor.image}
            alt={generalPastor.name}
            class="aspect-[4/5] md:aspect-auto md:min-h-[28rem]"
          />
          <div class="flex flex-col justify-center p-8 md:p-12">
            <p class="text-eyebrow uppercase tracking-[0.25em] text-accent">{generalPastor.role}</p>
            <h3 class="mt-2 text-h2 font-bold">{generalPastor.name}</h3>
            <div class="my-6 h-px w-12 bg-accent" aria-hidden="true"></div>
            <p class="text-body-lg leading-relaxed text-text-secondary">{generalPastor.bio}</p>
          </div>
        </article>

        <!-- Ancianos -->
        <div class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-3">
          {elders.map((member) => (
            <article data-reveal class="group overflow-hidden rounded-card bg-bg-block">
              <TeamPhoto src={member.image} alt={member.name} class="aspect-[4/5]" />
              <div class="p-6 md:p-7">
                <p class="text-eyebrow uppercase tracking-[0.25em] text-accent">{member.role}</p>
                <h3 class="mt-1 text-h3 font-bold">{member.name}</h3>
                <p class="mt-3 text-small leading-relaxed text-text-secondary">{member.bio}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 02 · Administración -->
    <section id="administracion" class="px-6 pb-20 md:pb-28">
      <div class="mx-auto max-w-6xl">
        <div data-reveal class="mb-10 md:mb-14">
          <p class="mb-4 flex items-center gap-3 text-eyebrow uppercase tracking-[0.3em] text-text-secondary">
            02 <span class="inline-block h-px w-10 bg-text-secondary/40"></span>
          </p>
          <h2 class="text-h2 font-bold text-balance">
            <span class="text-accent">Administración</span>
          </h2>
        </div>

        <article
          data-reveal
          class="group grid overflow-hidden rounded-card bg-bg-block md:grid-cols-[1fr_2fr]"
        >
          <TeamPhoto
            src={ADMINISTRACION.image}
            alt={ADMINISTRACION.name}
            class="aspect-[4/5] md:aspect-auto md:min-h-[20rem]"
          />
          <div class="flex flex-col justify-center p-8 md:p-12">
            <p class="text-eyebrow uppercase tracking-[0.25em] text-accent">{ADMINISTRACION.role}</p>
            <h3 class="mt-2 text-h3 font-bold">{ADMINISTRACION.name}</h3>
            <div class="my-5 h-px w-12 bg-accent" aria-hidden="true"></div>
            <p class="text-body leading-relaxed text-text-secondary">{ADMINISTRACION.bio}</p>
          </div>
        </article>
      </div>
    </section>

    <!-- 03 · Coordinadores de Ministerio -->
    <section id="coordinadores" class="px-6 pb-20 md:pb-28">
      <div class="mx-auto max-w-6xl">
        <div data-reveal class="mb-10 md:mb-14">
          <p class="mb-4 flex items-center gap-3 text-eyebrow uppercase tracking-[0.3em] text-text-secondary">
            03 <span class="inline-block h-px w-10 bg-text-secondary/40"></span>
          </p>
          <h2 class="text-h2 font-bold text-balance">
            Coordinadores de <span class="text-accent">Ministerio</span>
          </h2>
        </div>

        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {COORDINADORES.map((c) => (
            <article data-reveal class="group flex flex-col overflow-hidden rounded-card bg-bg-block">
              <!-- Una foto por persona (si hay dos, se muestran lado a lado) -->
              <div
                class:list={[
                  "grid aspect-square grid-rows-1 gap-0.5",
                  c.people.length > 1 ? "grid-cols-2" : "grid-cols-1",
                ]}
              >
                {c.people.map((person) => (
                  <TeamPhoto src={person.image} alt={person.name} />
                ))}
              </div>

              <div class="flex flex-1 flex-col p-5">
                <h3 class="text-body-lg font-bold">{c.people.map((p) => p.name).join(" y ")}</h3>
                {c.href ? (
                  <a
                    href={c.href}
                    class="mt-1 inline-flex w-fit items-center gap-1.5 text-small font-semibold text-accent hover:underline"
                  >
                    {c.ministry} <span aria-hidden="true">&rarr;</span>
                  </a>
                ) : (
                  <p class="mt-1 text-small font-semibold text-accent">{c.ministry}</p>
                )}
                <p class="mt-1 text-small text-text-secondary">{c.audience}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <CtaBanner />
  </main>
  <Footer />
  <BackToTop />
  <ScrollReveal />
</Layout>