---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import BackToTop from "../components/BackToTop.astro";
import ScrollReveal from "../components/ScrollReveal.astro";
import CopyField from "../components/CopyField.astro";
import { VERSE, PAYPAL_URL, IMAGES, BANK, SINPE, INITIATIVES } from "../lib/ofrendar";

const icons = {
  shield: `<path d="M12 3l8 3v6c0 4.5-3.4 8-8 9-4.6-1-8-4.5-8-9V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/>`,
  scale: `<path d="M12 4v16M6 20h12M5 7h14"/><path d="M5 7l-3 7a3.5 3.5 0 0 0 6 0zM19 7l-3 7a3.5 3.5 0 0 0 6 0z"/>`,
  ledger: `<path d="M6 3h9l4 4v14H6z"/><path d="M14 3v5h5M9 14l2 2 4-4"/>`,
  bank: `<path d="M3 10l9-6 9 6"/><path d="M5 10v8M9.5 10v8M14.5 10v8M19 10v8"/><path d="M3 21h18"/>`,
  sinpe: `<rect x="6.5" y="2.5" width="11" height="19" rx="2.5"/><path d="M10 9h4m-1.5-1.5L14 9l-1.5 1.5M14 14h-4m1.5 1.5L10 14l1.5-1.5"/>`,
  cash: `<rect x="2.5" y="6" width="19" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/><path d="M6 9.5v.01M18 14.5v.01"/>`,
  card: `<rect x="2.5" y="5" width="19" height="14" rx="2"/><path d="M2.5 10h19M6 15h4"/>`,
  wallet: `<path d="M3 7a2 2 0 0 1 2-2h13a1 1 0 0 1 1 1v2"/><path d="M3 7v11a2 2 0 0 0 2 2h14a1 1 0 0 0 1-1v-3"/><path d="M21 10v5h-4a2.5 2.5 0 0 1 0-5z"/>`,
  external: `<path d="M7 17L17 7M8 7h9v9"/>`,
  arrow: `<path d="M5 12h14M13 6l6 6-6 6"/>`,
} as const;

type IconName = keyof typeof icons;

const pillars: { title: string; icon: IconName }[] = [
  { title: "Mayordomía fiel", icon: "shield" },
  { title: "Prácticas comerciales éticas", icon: "scale" },
  { title: "Plena rendición de cuentas", icon: "ledger" },
];

// SINPE Móvil: se muestra con un espacio (8361 5562) pero se copia solo con
// los 8 dígitos, que es lo que aceptan las apps bancarias.
const sinpeDigits = SINPE.number.replace(/\D/g, "");
const sinpeDisplay =
  sinpeDigits.length === 8 ? `${sinpeDigits.slice(0, 4)} ${sinpeDigits.slice(4)}` : SINPE.number;
---

<Layout
  title="Ofrendar — Cristo Viene"
  description="Formas de ofrendar a Cristo Viene: transferencia, SINPE Móvil, efectivo, datáfono y PayPal."
>
  <Navbar />
  <main>
    <!-- Hero -->
    <section class="relative overflow-hidden px-6 pt-36 pb-20 text-center md:pt-48 md:pb-28">
      {IMAGES.hero && (
        <div
          aria-hidden="true"
          class="pointer-events-none absolute inset-0"
          style="-webkit-mask-image:linear-gradient(to bottom,#000 0%,#000 55%,transparent 100%);mask-image:linear-gradient(to bottom,#000 0%,#000 55%,transparent 100%);"
        >
          <Image src={IMAGES.hero} alt="" width={1600} height={900} priority class="h-full w-full object-cover" />
          <div class="absolute inset-0 bg-bg/65"></div>
        </div>
      )}

      <div data-reveal class="relative mx-auto max-w-3xl">
        <h1 class="text-hero font-bold text-balance">Ofrendar</h1>
        <div class="mx-auto mt-5 h-1 w-12 rounded-full bg-accent" aria-hidden="true"></div>

        <blockquote class="mx-auto mt-8 max-w-2xl">
          <p class="ff-light-italic text-body-lg leading-relaxed text-text-primary md:text-h3 md:leading-snug">
            “{VERSE.text}”
          </p>
          <footer class="mt-5">
            <cite class="text-small font-semibold uppercase tracking-[0.2em] text-accent not-italic">
              {VERSE.reference}
            </cite>
          </footer>
        </blockquote>

        <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
          <a
            href="#formas"
            class="rounded-full bg-accent px-8 py-3.5 text-body font-medium text-bg transition-transform hover:scale-[1.03]"
          >
            Formas de ofrendar
          </a>
          <a
            href={PAYPAL_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-full border border-text-secondary/50 bg-bg/40 px-8 py-3.5 text-body font-medium text-text-primary transition-colors hover:border-accent hover:text-accent"
          >
            Ofrendar con PayPal
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.external} />
          </a>
        </div>
      </div>
    </section>

    <!-- Invitación -->
    <section class="px-6 pb-20 md:pb-28">
      <div data-reveal class="mx-auto grid max-w-6xl overflow-hidden rounded-card bg-bg-block md:grid-cols-2">
        <div class="relative aspect-[4/3] md:aspect-auto md:min-h-[26rem]">
          {IMAGES.intro ? (
            <Image
              src={IMAGES.intro}
              alt="Comunidad de Cristo Viene"
              loading="lazy"
              width={1200}
              height={900}
              class="absolute inset-0 h-full w-full object-cover"
            />
          ) : (
            <div class="absolute inset-0 flex items-center justify-center border-b border-dashed border-text-secondary/40 text-small text-text-secondary md:border-b-0 md:border-r">
              Foto
            </div>
          )}
        </div>

        <div class="flex flex-col justify-center p-8 md:p-12">
          <p class="mb-4 flex items-center gap-3 text-eyebrow uppercase tracking-[0.3em] text-text-secondary">
            Nuestra invitación <span class="inline-block h-px w-10 bg-text-secondary/40"></span>
          </p>
          <h2 class="text-h2 font-bold text-balance">
            La iglesia se sostiene por la <span class="text-accent">gracia</span> de Dios
          </h2>
          <p class="mt-5 text-body-lg leading-relaxed text-text-secondary">
            Él mismo nos invita a participar de esta función de ofrendar. Te animamos a hacerlo y a
            sumarte a dar a conocer a Jesús y enseñar la vida que Él quiere que vivamos.
          </p>
        </div>
      </div>
    </section>

    <!-- Cómo honramos las ofrendas -->
    <section class="px-6 pb-20 md:pb-28">
      <div class="mx-auto max-w-6xl">
        <h2 data-reveal class="mb-10 max-w-xl text-h2 font-bold text-balance">
          Honramos sus ofrendas con
        </h2>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
          {pillars.map((pillar) => (
            <article data-reveal class="flex items-center gap-5 rounded-card bg-bg-block p-6 md:p-8">
              <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-bg-block-secondary text-accent">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[pillar.icon]} />
              </span>
              <h3 class="text-body-lg font-bold">{pillar.title}</h3>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Formas de ofrendar -->
    <section id="formas" class="px-6 pb-20 md:pb-28">
      <div class="mx-auto max-w-6xl">
        <div data-reveal class="mb-10 md:mb-14">
          <p class="mb-4 flex items-center gap-3 text-eyebrow uppercase tracking-[0.3em] text-text-secondary">
            Cinco opciones
          </p>
          <h2 class="text-h2 font-bold text-balance">
            Formas de ofrendar
          </h2>
        </div>

        <!-- 01 · Transferencia -->
        <article data-reveal class="rounded-card bg-bg-block p-6 md:p-10">
          <header class="flex items-center gap-4">
            <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-bg-block-secondary text-accent">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.bank} />
            </span>
            <div>
              <p class="text-eyebrow uppercase tracking-[0.25em] text-accent">01</p>
              <h3 class="text-h3 font-bold">Transferencia</h3>
              <p class="text-small text-text-secondary">{BANK.name}</p>
            </div>
          </header>

          <div class="mt-8 grid gap-6 md:grid-cols-2">
            {BANK.accounts.map((a) => (
              <div class="rounded-2xl border border-text-secondary/20 p-5 md:p-6">
                <p class="mb-4 inline-flex rounded-full bg-accent/15 px-3 py-1 text-eyebrow uppercase tracking-[0.2em] text-accent">
                  {a.currency}
                </p>
                <div class="space-y-3">
                  <CopyField label="Cuenta" value={a.account} copyLabel={`cuenta en ${a.currency.toLowerCase()}`} />
                  <CopyField label="Cuenta cliente" value={a.client} copyLabel={`cuenta cliente en ${a.currency.toLowerCase()}`} />
                  <CopyField label="IBAN" value={a.iban} copyLabel={`IBAN en ${a.currency.toLowerCase()}`} />
                </div>
              </div>
            ))}
          </div>

          <div class="mt-6 grid gap-3 border-t border-text-secondary/20 pt-6 sm:grid-cols-2">
            <CopyField label="Nombre" value={BANK.holder} copyLabel="nombre del beneficiario" />
            <CopyField label="Concepto" value={BANK.concept} copyLabel="concepto" />
          </div>
        </article>

        <!-- 02 · SINPE Móvil: bloque propio para darle espacio al número y sus datos. -->
        <article data-reveal class="mt-6 rounded-card bg-bg-block p-6 md:p-8">
          <div class="grid gap-6 md:grid-cols-[minmax(0,1fr)_minmax(18rem,1.2fr)] md:items-center">
            <div>
              <header class="flex items-center gap-4">
                <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-bg-block-secondary text-accent">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.sinpe} />
                </span>
                <div>
                  <p class="text-eyebrow uppercase tracking-[0.25em] text-accent">02</p>
                  <h3 class="text-h3 font-bold">SINPE Móvil</h3>
                </div>
              </header>
              <p class="mt-4 text-body text-text-secondary">
                Envía tu ofrenda desde la app de tu banco usando nuestro número.
              </p>
            </div>

            <div class="space-y-3">
              {sinpeDigits ? (
                <CopyField
                  label="Número"
                  value={sinpeDisplay}
                  copyValue={sinpeDigits}
                  copyLabel="número de SINPE Móvil"
                />
              ) : (
                <p class="rounded-xl border border-dashed border-text-secondary/40 px-4 py-3 text-small text-text-secondary">
                  Número por definir.
                </p>
              )}

              {SINPE.holder && (
                <p class="text-small text-text-secondary">
                  A nombre de <span class="text-text-primary">{SINPE.holder}</span>
                </p>
              )}

              {SINPE.detail && (
                <CopyField label="Detalle" value={SINPE.detail} copyLabel="detalle del envío" />
              )}
            </div>
          </div>
        </article>

        <!-- 03 a 05: tres opciones en una fila -->
        <div class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          <!-- 03 · Efectivo -->
          <article data-reveal class="flex flex-col rounded-card bg-bg-block p-8">
            <span class="flex h-14 w-14 items-center justify-center rounded-full bg-bg-block-secondary text-accent">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.cash} />
            </span>
            <p class="mt-6 text-eyebrow uppercase tracking-[0.25em] text-accent">03</p>
            <h3 class="mt-1 text-h3 font-bold">Efectivo</h3>
            <p class="mt-3 text-body text-text-secondary">En efectivo en las reuniones generales.</p>
            <a
              href="/visitanos"
              class="mt-6 inline-flex w-fit items-center gap-2 text-small font-semibold text-accent transition-opacity hover:opacity-80"
            >
              Ver horarios de reunión
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.arrow} />
            </a>
          </article>

          <!-- 04 · En forma electrónica -->
          <article data-reveal class="flex flex-col rounded-card bg-bg-block p-8">
            <span class="flex h-14 w-14 items-center justify-center rounded-full bg-bg-block-secondary text-accent">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.card} />
            </span>
            <p class="mt-6 text-eyebrow uppercase tracking-[0.25em] text-accent">04</p>
            <h3 class="mt-1 text-h3 font-bold">En forma electrónica</h3>
            <p class="mt-3 text-body text-text-secondary">
              Por medio de datáfono, en las reuniones generales.
            </p>
            <a
              href="/visitanos"
              class="mt-6 inline-flex w-fit items-center gap-2 text-small font-semibold text-accent transition-opacity hover:opacity-80"
            >
              Ver horarios de reunión
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.arrow} />
            </a>
          </article>

          <!-- 05 · PayPal: tarjeta destacada -->
          <article data-reveal class="flex flex-col rounded-card bg-accent p-8 text-bg">
            <span class="flex h-14 w-14 items-center justify-center rounded-full bg-bg/15">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.wallet} />
            </span>
            <p class="mt-6 text-eyebrow uppercase tracking-[0.25em] opacity-80">05</p>
            <h3 class="mt-1 text-h3 font-bold">PayPal</h3>
            <p class="mt-3 text-body opacity-90">
              Permite donación a través de PayPal o ingresando su tarjeta de crédito o débito.
            </p>
            <a
              href={PAYPAL_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-6 inline-flex w-fit items-center gap-2 rounded-full bg-bg px-6 py-2.5 text-small font-semibold uppercase tracking-wide text-text-primary transition-transform hover:scale-[1.03]"
            >
              Donar
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.external} />
            </a>
          </article>
        </div>
      </div>
    </section>

    <!-- Iniciativas -->
    <section id="iniciativas" class="px-6 pb-24 md:pb-32">
      <div class="mx-auto max-w-6xl">
        <div data-reveal class="mb-10 md:mb-14">
          <p class="mb-4 flex items-center gap-3 text-eyebrow uppercase tracking-[0.3em] text-text-secondary">
            Conoce más
          </p>
          <h2 class="text-h2 font-bold text-balance">
            <span class="text-accent">Iniciativas</span>
          </h2>
        </div>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
          {INITIATIVES.map((item) => (
            <article data-reveal class="group overflow-hidden rounded-card bg-bg-block">
              <div class="relative aspect-[4/3] overflow-hidden bg-bg-block-secondary">
                {item.image ? (
                  <Image
                    src={item.image}
                    alt={item.name}
                    loading="lazy"
                    width={900}
                    height={675}
                    class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                ) : (
                  <div class="absolute inset-0 flex items-center justify-center border-b border-dashed border-text-secondary/40 text-small text-text-secondary">
                    Foto
                  </div>
                )}
              </div>

              <div class="p-6 md:p-7">
                <h3 class="text-h3 font-bold">{item.name}</h3>
                {item.description && (
                  <p class="mt-2 text-small leading-relaxed text-text-secondary">{item.description}</p>
                )}
                {item.href && (
                  <a
                    href={item.href}
                    class="mt-5 inline-flex items-center gap-2 text-small font-semibold text-accent transition-opacity hover:opacity-80"
                  >
                    Conocer más
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.arrow} />
                  </a>
                )}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>

  <!-- Anuncia a lectores de pantalla cuando se copia un dato -->
  <p id="copy-status" class="sr-only" role="status" aria-live="polite"></p>

  <Footer />
  <BackToTop />
  <ScrollReveal />
</Layout>

<style>
  /* Variante cursiva ligera de Aller (la familia que ya tienes en global.css). */
  .ff-light-italic {
    font-family: "Aller Light Italic", "Aller", ui-sans-serif, system-ui, sans-serif;
    font-style: normal;
    font-weight: 400;
  }
</style>
