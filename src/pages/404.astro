---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Página no encontrada — Cristo Viene"
  description="La página que buscas no está disponible. Regresa al inicio de Cristo Viene."
>
  <div class="not-found-layout">
    <Navbar />

    <main class="not-found-main flex items-center justify-center px-6 pb-16 pt-36 text-center md:pt-40">
      <section class="mx-auto max-w-2xl" aria-labelledby="titulo-error">
        <p class="error-code" aria-hidden="true">
          404
        </p>
        <h1 id="titulo-error" class="text-h2 font-bold text-text-primary" style="margin-top: 3rem">
          Esta página no se encuentra
        </h1>
        <p class="mx-auto max-w-lg text-body-lg leading-relaxed text-text-secondary" style="margin: 1.5rem auto 0">
          Parece que el enlace cambió o la página ya no está disponible. Puedes volver al inicio y seguir explorando.
        </p>
        <a
          href="/"
          class="inline-flex items-center justify-center gap-2 rounded-full bg-accent px-7 py-3.5 text-body font-semibold text-bg transition-opacity hover:opacity-85 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
          style="margin-top: 2.5rem"
        >
          Ir al inicio
        </a>
      </section>
    </main>

    <Footer />
  </div>
</Layout>

<style>
  .not-found-layout {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .not-found-main {
    flex: 1 0 auto;
    min-height: 75vh;
  }

  .error-code {
    color: var(--raw-text-secondary);
    font-size: clamp(9rem, 33vw, 24rem);
    font-weight: 700;
    letter-spacing: -0.06em;
    line-height: 0.72;
  }

</style>
