---
import Layout from "../../../layouts/Layout.astro";
import Navbar from "../../../components/Navbar.astro";
import PageHeader from "../../../components/PageHeader.astro";
import Footer from "../../../components/Footer.astro";
import BackToTop from "../../../components/BackToTop.astro";
import ScrollReveal from "../../../components/ScrollReveal.astro";
import { getAllSeries } from "../../../lib/series";

const series = await getAllSeries();

// Años únicos presentes, para poblar el <select> de filtro.
const years = [...new Set(series.map((s) => s.year).filter(Boolean))].sort(
  (a, b) => (b as number) - (a as number)
);
---

<Layout title="Series de Mensajes — Cristo Viene">
  <Navbar />
  <main>
    <PageHeader eyebrow="Mensajes" title="Todas las series" />

    <!-- Buscador / filtro (client-side, sobre los datos ya cargados) -->
    <section class="px-6 pb-12">
      <div class="mx-auto max-w-6xl">
        <div class="flex flex-col md:flex-row items-stretch md:items-center gap-3 rounded-block bg-bg-block p-3">
          <div class="flex flex-1 items-center gap-3 px-3">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" class="shrink-0 text-text-secondary" aria-hidden="true">
              <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.6" />
              <path d="M21 21l-4.3-4.3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            </svg>
            <input
              id="series-search"
              type="search"
              placeholder="Buscar series..."
              class="w-full bg-transparent py-2.5 text-body text-text-primary placeholder:text-text-secondary focus:outline-none"
              aria-label="Buscar series"
            />
          </div>

          <select
            id="series-year-filter"
            class="rounded-full border border-text-secondary/30 bg-transparent px-4 py-2.5 text-small text-text-primary focus:outline-none focus:border-accent"
            aria-label="Filtrar por año"
          >
            <option value="">Todos los años</option>
            {years.map((y) => <option value={y}>{y}</option>)}
          </select>
        </div>

        <p id="series-empty-state" class="hidden text-body text-text-secondary text-center mt-10">
          No encontramos series que coincidan con tu búsqueda.
        </p>
      </div>
    </section>

    <section class="px-6 pb-24 md:pb-32">
      <div id="series-grid" class="mx-auto max-w-6xl grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {series.map((serie) => (
          <a
            href={`/mensajes/series/${serie.slug}`}
            data-series-card
            data-title={serie.title.toLowerCase()}
            data-year={serie.year ?? ""}
            data-reveal
            class="group block overflow-hidden rounded-card bg-bg-block transition-transform hover:-translate-y-1"
          >
            <div
              class="aspect-[16/10] bg-bg-block-secondary bg-cover bg-center"
              style={serie.thumbnail ? `background-image:url(${serie.thumbnail})` : undefined}
            ></div>
            <div class="p-5">
              <h3 class="text-body-lg font-bold mb-1 capitalize group-hover:text-accent transition-colors">
                {serie.title}
              </h3>
              <div class="flex items-center justify-between">
                {serie.trackCount && (
                  <p class="text-small text-text-secondary">{serie.trackCount} mensajes</p>
                )}
                {serie.year && <p class="text-small text-text-secondary">{serie.year}</p>}
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>
  <Footer />
  <BackToTop />
  <ScrollReveal />
</Layout>

<script>
  const searchInput = document.getElementById("series-search") as HTMLInputElement | null;
  const yearFilter = document.getElementById("series-year-filter") as HTMLSelectElement | null;
  const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-series-card]"));
  const emptyState = document.getElementById("series-empty-state");

  function applyFilters() {
    const query = searchInput?.value.trim().toLowerCase() ?? "";
    const year = yearFilter?.value ?? "";

    let visibleCount = 0;

    cards.forEach((card) => {
      const matchesQuery = !query || card.dataset.title?.includes(query);
      const matchesYear = !year || card.dataset.year === year;
      const visible = matchesQuery && matchesYear;
      card.classList.toggle("hidden", !visible);
      if (visible) visibleCount++;
    });

    emptyState?.classList.toggle("hidden", visibleCount > 0);
  }

  searchInput?.addEventListener("input", applyFilters);
  yearFilter?.addEventListener("change", applyFilters);
</script>