---
import Layout from "../../../layouts/Layout.astro";
import Navbar from "../../../components/Navbar.astro";
import PageHeader from "../../../components/PageHeader.astro";
import Footer from "../../../components/Footer.astro";
import BackToTop from "../../../components/BackToTop.astro";
import ScrollReveal from "../../../components/ScrollReveal.astro";
import { getAllSeries } from "../../../lib/series";

const series = await getAllSeries();

// Años únicos presentes (el más reciente primero), para el dropdown de filtro.
const years = [
  ...new Set(series.map((s) => s.year).filter((y): y is number => Boolean(y))),
].sort((a, b) => b - a);
---

<Layout title="Series de Mensajes — Cristo Viene">
  <Navbar />
  <main>
    <PageHeader eyebrow="Mensajes" title="Todas las series" />

    <!-- Buscador / filtro (client-side, sobre los datos ya cargados) -->
    <section class="px-6 pb-12">
      <div class="mx-auto max-w-6xl">
        <div class="flex flex-col items-stretch gap-3 rounded-block bg-bg-block p-3 md:flex-row md:items-center">
          <!-- Buscador: el borde de acento rodea todo el campo (ícono + texto). -->
          <label class="flex flex-1 cursor-text items-center gap-3 rounded-full border border-transparent px-4 transition-colors focus-within:border-accent">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" class="shrink-0 text-text-secondary" aria-hidden="true">
              <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.6" />
              <path d="M21 21l-4.3-4.3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            </svg>
            <input
              id="series-search"
              type="search"
              placeholder="Buscar series..."
              autocomplete="off"
              aria-label="Buscar series"
              class="w-full bg-transparent py-2.5 text-body text-text-primary placeholder:text-text-secondary"
            />
          </label>

          <!-- Dropdown de año (lista propia, accesible por teclado) -->
          {years.length > 0 && (
            <div class="relative" data-year-dropdown>
              <button
                type="button"
                role="combobox"
                id="series-year-button"
                data-year-button
                aria-haspopup="listbox"
                aria-expanded="false"
                aria-controls="series-year-list"
                aria-label="Filtrar por año"
                class="group flex w-full items-center justify-between gap-3 rounded-full border border-text-secondary/30 px-5 py-2.5 text-small text-text-primary transition-colors hover:border-accent/60 focus-visible:border-accent aria-expanded:border-accent md:w-auto md:min-w-44"
              >
                <span data-year-label>Todos los años</span>
                <svg
                  class="shrink-0 transition-transform duration-200 group-aria-expanded:rotate-180"
                  width="12"
                  height="7"
                  viewBox="0 0 10 6"
                  fill="none"
                  aria-hidden="true"
                >
                  <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>

              <ul
                id="series-year-list"
                data-year-list
                role="listbox"
                aria-label="Años"
                hidden
                class="absolute inset-x-0 top-full z-30 mt-2 max-h-64 overflow-y-auto rounded-xl border border-text-secondary/20 bg-bg-block-secondary p-1.5 shadow-xl md:left-auto md:right-0 md:w-auto md:min-w-full"
              >
                <li
                  role="option"
                  id="series-year-option-all"
                  data-value=""
                  aria-selected="true"
                  class="group flex cursor-pointer items-center justify-between gap-4 rounded-lg px-3 py-2.5 text-small text-text-primary aria-selected:text-accent data-active:bg-text-primary/10"
                >
                  <span>Todos los años</span>
                  <svg class="opacity-0 group-aria-selected:opacity-100" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12.5l4.5 4.5L19 7.5" />
                  </svg>
                </li>

                {years.map((year) => (
                  <li
                    role="option"
                    id={`series-year-option-${year}`}
                    data-value={year}
                    aria-selected="false"
                    class="group flex cursor-pointer items-center justify-between gap-4 rounded-lg px-3 py-2.5 text-small text-text-primary aria-selected:text-accent data-active:bg-text-primary/10"
                  >
                    <span>{year}</span>
                    <svg class="opacity-0 group-aria-selected:opacity-100" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M5 12.5l4.5 4.5L19 7.5" />
                    </svg>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>

        <p id="series-empty-state" class="hidden text-body text-text-secondary text-center mt-10">
          No encontramos series que coincidan con tu búsqueda.
        </p>
      </div>
    </section>

    <section class="px-6 pb-24 md:pb-32">
      <div id="series-grid" class="mx-auto grid max-w-6xl grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {series.map((serie) => (
          <a
            href={`/mensajes/series/${serie.slug}`}
            data-series-card
            data-title={serie.title.toLowerCase()}
            data-year={serie.year ?? ""}
            data-reveal
            class="group block overflow-hidden rounded-card bg-bg-block transition-transform hover:-translate-y-1"
          >
            <div
              class="aspect-[16/10] bg-bg-block-secondary bg-cover bg-center"
              style={serie.thumbnail ? `background-image:url(${serie.thumbnail})` : undefined}
            ></div>
            <div class="p-5">
              <h3 class="mb-1 text-body-lg font-bold capitalize transition-colors group-hover:text-accent">
                {serie.title}
              </h3>
              <div class="flex items-center justify-between">
                {serie.trackCount && (
                  <p class="text-small text-text-secondary">{serie.trackCount} mensajes</p>
                )}
                {serie.year && <p class="text-small text-text-secondary">{serie.year}</p>}
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>
  <Footer />
  <BackToTop />
  <ScrollReveal />
</Layout>

<style>
  /*
    global.css define un contorno de acento para :focus-visible. Estos
    controles ya muestran el foco con su propio borde, así que el contorno
    global se veía como un segundo borde. Aquí se quita: queda uno solo.
  */
  #series-search:focus-visible,
  [data-year-button]:focus-visible {
    outline: none;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  let teardown: (() => void) | null = null;

  function initSeriesFilters() {
    teardown?.();
    teardown = null;

    const searchEl = document.getElementById("series-search") as HTMLInputElement | null;
    if (!searchEl) return;
    const search: HTMLInputElement = searchEl;

    const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-series-card]"));
    const emptyState = document.getElementById("series-empty-state");

    let selectedYear = "";

    function applyFilters() {
      const query = search.value.trim().toLowerCase();
      let visibleCount = 0;

      cards.forEach((card) => {
        const matchesQuery = !query || card.dataset.title?.includes(query);
        const matchesYear = !selectedYear || card.dataset.year === selectedYear;
        const visible = Boolean(matchesQuery && matchesYear);
        card.classList.toggle("hidden", !visible);
        if (visible) visibleCount++;
      });

      emptyState?.classList.toggle("hidden", visibleCount > 0);

      // Las cards cambian de posición al filtrar: se recalculan las
      // animaciones de scroll para que ninguna quede invisible.
      ScrollTrigger.refresh();
    }

    search.addEventListener("input", applyFilters);
    applyFilters(); // por si el navegador restauró texto en el buscador

    // ---- Dropdown de año ----
    const dropdown = document.querySelector<HTMLElement>("[data-year-dropdown]");
    if (!dropdown) return;

    const button = dropdown.querySelector<HTMLButtonElement>("[data-year-button]")!;
    const list = dropdown.querySelector<HTMLElement>("[data-year-list]")!;
    const label = dropdown.querySelector<HTMLElement>("[data-year-label]")!;
    const options = Array.from(list.querySelectorAll<HTMLElement>('[role="option"]'));

    let activeIndex = 0;
    const isOpen = () => !list.hidden;

    function setActive(index: number) {
      activeIndex = Math.max(0, Math.min(options.length - 1, index));
      options.forEach((option, i) => option.toggleAttribute("data-active", i === activeIndex));
      button.setAttribute("aria-activedescendant", options[activeIndex].id);
      options[activeIndex].scrollIntoView({ block: "nearest" });
    }

    const onOutsideClick = (event: MouseEvent) => {
      if (!dropdown.contains(event.target as Node)) close();
    };

    function open() {
      list.hidden = false;
      button.setAttribute("aria-expanded", "true");
      setActive(options.findIndex((o) => o.getAttribute("aria-selected") === "true"));
      gsap.fromTo(
        list,
        { opacity: 0, y: -6 },
        { opacity: 1, y: 0, duration: 0.18, ease: "power2.out", clearProps: "opacity,transform" }
      );
      document.addEventListener("click", onOutsideClick);
    }

    function close() {
      list.hidden = true;
      button.setAttribute("aria-expanded", "false");
      button.removeAttribute("aria-activedescendant");
      options.forEach((option) => option.removeAttribute("data-active"));
      document.removeEventListener("click", onOutsideClick);
    }

    function choose(index: number) {
      const option = options[index];
      selectedYear = option.dataset.value ?? "";
      options.forEach((o, i) => o.setAttribute("aria-selected", String(i === index)));
      label.textContent = option.querySelector("span")?.textContent ?? "";
      close();
      applyFilters();
    }

    button.addEventListener("click", () => (isOpen() ? close() : open()));

    button.addEventListener("keydown", (event) => {
      switch (event.key) {
        case "ArrowDown":
          event.preventDefault();
          if (isOpen()) setActive(activeIndex + 1);
          else open();
          break;
        case "ArrowUp":
          event.preventDefault();
          if (isOpen()) setActive(activeIndex - 1);
          else open();
          break;
        case "Home":
          if (isOpen()) {
            event.preventDefault();
            setActive(0);
          }
          break;
        case "End":
          if (isOpen()) {
            event.preventDefault();
            setActive(options.length - 1);
          }
          break;
        case "Enter":
        case " ":
          event.preventDefault();
          if (isOpen()) choose(activeIndex);
          else open();
          break;
        case "Escape":
          if (isOpen()) {
            event.preventDefault();
            close();
          }
          break;
        case "Tab":
          close();
          break;
      }
    });

    // Evita que el clic en la barra espaciadora dispare un segundo "click" (Firefox).
    button.addEventListener("keyup", (event) => {
      if (event.key === " ") event.preventDefault();
    });

    // Mantiene el foco en el botón al hacer clic en una opción.
    list.addEventListener("mousedown", (event) => event.preventDefault());

    list.addEventListener("pointermove", (event) => {
      const option = (event.target as HTMLElement).closest<HTMLElement>('[role="option"]');
      if (option) setActive(options.indexOf(option));
    });

    list.addEventListener("click", (event) => {
      const option = (event.target as HTMLElement).closest<HTMLElement>('[role="option"]');
      if (option) choose(options.indexOf(option));
    });

    teardown = () => document.removeEventListener("click", onOutsideClick);
  }

  document.addEventListener("astro:page-load", initSeriesFilters);
  document.addEventListener("astro:before-swap", () => {
    teardown?.();
    teardown = null;
  });
</script>