---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Cristo Viene",
  description = "Trabajamos para dar a conocer a Jesús y enseñar la vida que Él quiere que vivamos.",
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="bg-bg text-text-primary font-sans antialiased overflow-x-hidden">
    <slot />
  </body>
</html>
