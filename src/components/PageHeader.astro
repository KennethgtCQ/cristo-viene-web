---
interface Props {
  eyebrow: string;
  title: string;
}

const { eyebrow, title } = Astro.props;
---

<section class="px-6 pt-36 pb-16 md:pt-44 md:pb-20 text-center">
  <div class="mx-auto max-w-3xl">
    <p class="text-eyebrow uppercase tracking-[0.3em] text-text-secondary mb-4">
      {eyebrow}
    </p>
    <h1 class="text-h2 font-bold text-balance">{title}</h1>
  </div>
</section>