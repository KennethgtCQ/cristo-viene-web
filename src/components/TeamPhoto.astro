---
// Foto de una persona del equipo. Si no hay "src" muestra un recuadro con una
// silueta. Para el zoom al pasar el mouse, el contenedor padre debe tener la
// clase "group".
interface Props {
  src?: string;
  alt: string;
  class?: string;
}

const { src, alt, class: className } = Astro.props;
---

<div class:list={["relative overflow-hidden bg-bg-block-secondary", className]}>
  {src ? (
    <img
      src={src}
      alt={alt}
      loading="lazy"
      decoding="async"
      class="absolute inset-0 h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-105"
    />
  ) : (
    <div
      role="img"
      aria-label={`Foto de ${alt}`}
      class="absolute inset-0 flex items-center justify-center"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="0.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="h-1/3 w-1/3 text-text-secondary/40"
        aria-hidden="true"
      >
        <circle cx="12" cy="8" r="4" />
        <path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7" />
      </svg>
    </div>
  )}
</div>