---
import { Image } from "astro:assets";
import CardShape from "../images/card.svg";
import feImage from "../images/fe.jpg";
import relacionImage from "../images/relacion.avif";
import equipoImage from "../images/equipo.avif";
const cards = [
  {
    key: "fe",
    href: "/conocenos/doctrina",
    title: "FE",
    text: "Creemos en un Dios real que transforma vidas y cumple sus promesas",
    color: "var(--color-card-fe)",
    svgColor: "#9D5959", // Color específico para el SVG
    align: "up",
    img: feImage,
    icon: '<path d="M12 3v18M6 8h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>',
  },
  {
    key: "relacion",
    href: "/conocenos/historia",
    title: "RELACIÓN",
    text: "Nuestra relación con Dios se basa en el amor y se fortalece en comunidad.",
    color: "var(--color-card-relacion)",
    svgColor: "#C28458", // Color específico para el SVG
    align: "down",
    img: relacionImage,
    icon: '<path d="M12 20s-7-4.35-9.3-8.6C1.2 8.4 2.9 5.5 6 5c2-.3 3.6.9 6 3.3C14.4 5.9 16 4.7 18 5c3.1.5 4.8 3.4 3.3 6.4C19 15.65 12 20 12 20z" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linejoin="round"/>',
  },
  {
    key: "equipo",
    href: "/equipo",
    title: "EQUIPO",
    text: "Nos damos la mano unos a otros para servir y hacer la diferencia.",
    color: "var(--color-card-equipo)",
    svgColor: "#4C69B3", // Color específico para el SVG
    align: "up",
    img: equipoImage,
    icon: '<circle cx="8" cy="9" r="2.6" stroke="currentColor" stroke-width="1.4" fill="none"/><circle cx="16" cy="9" r="2.6" stroke="currentColor" stroke-width="1.4" fill="none"/><path d="M3 19c0-2.8 2.3-4.6 5-4.6s5 1.8 5 4.6M11 19c0-2.8 2.3-4.6 5-4.6s5 1.8 5 4.6" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linecap="round"/>',
  },
];
---

<section id="mensajes" class="px-6 py-20 md:py-28">
  <div class="mx-auto max-w-6xl">
    <p class="text-eyebrow uppercase tracking-[0.3em] text-text-secondary mb-4 flex items-center gap-3">
      Nuestra esencia 
    </p>
    <h2 class="text-h2 font-bold max-w-lg text-balance mb-14 md:mb-20">
      En todo lo que hacemos, Dios es el <span class="text-accent">centro</span>
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-6 items-start">
      {cards.map((card) => (
        <div
          data-reveal
          class:list={["md:mt-0", card.align === "down" && "md:mt-16"]}
        >
          <!-- Tarjeta principal -->
          <div class="essence-card relative aspect-[2/3] w-full overflow-hidden rounded-[1rem] bg-white">
            
            <!-- 1. IMAGEN DE FONDO (Visible en la zona superior derecha) -->
            <Image
              src={card.img}
              alt={card.title}
              loading="lazy"
              class="absolute inset-0 h-full w-full object-cover"
              widths={[320, 500, 700]}
              sizes="(min-width: 768px) 33vw, 100vw"
            />

            <!-- 2. FORMA SVG ORIGINAL (Ocupa todo el alto, respeta la curva) -->
            <CardShape
              class="absolute inset-0 z-10 h-full w-full pointer-events-none"
              style={`fill: ${card.svgColor};`}
              preserveAspectRatio="none"
            />

            <!-- 3. CONTENIDO INFERIOR (Texto y Botón) -->
            <div class="absolute inset-x-0 bottom-0 top-[42%] z-20 flex flex-col justify-end p-5 md:p-6">
              
              <!-- Ícono -->
              <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-full border border-white text-white">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" set:html={card.icon} />
              </div>
              
              <h3 class="text-h3 font-bold text-white mb-2">{card.title}</h3>
              <p class="text-small text-white/85 mb-5 max-w-[85%]">{card.text}</p>
              <a
                href={card.href}
                class="inline-flex items-center gap-2 text-small font-semibold uppercase tracking-wide text-white group"
              >
                Conoce más
                <span class="transition-transform group-hover:translate-x-1">&rarr;</span>
              </a>
            </div>

          </div>
        </div>
      ))}
    </div>
  </div>
</section>
