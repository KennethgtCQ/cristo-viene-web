---
const items = [
  {
    title: "Cordialidad familiar",
    text: "Nos esforzamos por brindar la mejor atención a quien nos visita para que nos conozca y así pueda tener una visión clara de lo que hacemos y creemos.",
    icon: "handshake",
  },
  {
    title: "Sentido de comunidad",
    text: "Somos una familia que se preocupa entre sí por el amor que nos une en Jesús.",
    icon: "people",
  },
  {
    title: "Relevancia cultural",
    text: "Nos esforzamos por aplicar a la vida real los valores eternos de la palabra de Dios.",
    icon: "globe",
  },
];

const icons: Record<string, string> = {
  handshake:
    '<path d="M2 12l4-4 4 3 3-3 4 4M2 12l3 3M22 12l-3 3M9 11l2 6M15 11l-2 6" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linecap="round" stroke-linejoin="round"/>',
  people:
    '<circle cx="8" cy="8" r="3" stroke="currentColor" stroke-width="1.4" fill="none"/><circle cx="16" cy="8" r="3" stroke="currentColor" stroke-width="1.4" fill="none"/><path d="M2 19c0-3 3-5 6-5s6 2 6 5M10 19c0-3 3-5 6-5s6 2 6 5" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linecap="round"/>',
  globe:
    '<circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.4" fill="none"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.7 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.7-3.8-9S9.5 5.6 12 3z" stroke="currentColor" stroke-width="1.4" fill="none"/>',
};
---

<section id="conocenos" class="px-6 py-20 md:py-28">
  <div class="mx-auto max-w-5xl text-center">
    <p class="text-eyebrow uppercase tracking-[0.3em] text-text-secondary mb-4">
      ¿Qué puedes esperar?
    </p>
    <h2 class="text-h2 font-bold text-balance">
      Nuestro <span class="text-accent">compromiso</span> contigo
    </h2>

    <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-12 md:gap-0 md:divide-x md:divide-text-secondary/20 text-left">
      {items.map((item) => (
        <div data-reveal class="md:px-8 first:md:pl-0 last:md:pr-0">
          <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-full bg-bg-block-secondary text-accent">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" set:html={icons[item.icon]} />
          </div>
          <h3 class="text-h3 font-bold mb-2">{item.title}</h3>
          <p class="text-body text-text-secondary">{item.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
