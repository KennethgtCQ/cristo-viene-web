---
import "maplibre-gl/dist/maplibre-gl.css";

interface Props {
  /** Alto mínimo del mapa en px. */
  alturaMinima?: number;
}

const { alturaMinima = 400 } = Astro.props;
---

<div class="mapa-wrapper" style={`--mapa-alto-min:${alturaMinima}px`}>
  <div
    id="mapa-cristo-viene"
    role="region"
    aria-label="Mapa con la ubicación de Iglesia Cristo Viene en Cartago"
  ></div>
</div>

<script>
  import * as maplibregl from "maplibre-gl";
  import { setWorkerUrl } from "maplibre-gl";
  import workerUrl from "maplibre-gl/dist/maplibre-gl-worker.mjs?worker&url";
  import { UBICACION, COMO_LLEGAR_URL } from "../lib/ubicacion";

  // Vite debe servir el worker de MapLibre como un asset; sin esto, MapLibre
  // solo dibuja elementos HTML (como el marcador) y el mapa queda negro.
  setWorkerUrl(workerUrl);

  const ESTILO_URL = "https://tiles.openfreemap.org/styles/liberty";
  const TEMAS = {
    oscuro: {
      fondo: "#1C1C1C",
      construcciones: "#1C1C1C",
      calles: "#D9D9D9",
      textoCalles: "#434343",
      textoSecundario: "#FFFFFF",
    },
    claro: {
      fondo: "#FFFFFF",
      construcciones: "#F1F1F1",
      calles: "#D9D9D9",
      textoCalles: "#4C4C4C",
      textoSecundario: "#4C4C4C",
    },
  };

  type Tema = (typeof TEMAS)[keyof typeof TEMAS];

  let estiloBase: any;

  async function obtenerEstiloBase() {
    if (!estiloBase) {
      const respuesta = await fetch(ESTILO_URL);
      if (!respuesta.ok) throw new Error(`OpenFreeMap respondió ${respuesta.status}`);
      estiloBase = await respuesta.json();
    }
    return estiloBase;
  }

  function aplicarColores(estiloOriginal: any, colores: Tema) {
    const estilo = structuredClone(estiloOriginal);

    for (const capa of estilo.layers) {
      const sourceLayer = capa["source-layer"] ?? "";
      const id = String(capa.id).toLowerCase();
      capa.paint ??= {};

      if (capa.type === "background") {
        capa.paint["background-color"] = colores.fondo;
        delete capa.paint["background-pattern"];
        continue;
      }

      if (capa.type === "fill" && ["building", "landcover", "landuse", "water"].includes(sourceLayer)) {
        capa.paint["fill-color"] = sourceLayer === "building"
          ? colores.construcciones
          : colores.fondo;
        delete capa.paint["fill-pattern"];
        delete capa.paint["fill-outline-color"];
        continue;
      }

      if (capa.type === "fill-extrusion" && sourceLayer === "building") {
        capa.paint["fill-extrusion-color"] = colores.construcciones;
        continue;
      }

      if (capa.type === "line" && sourceLayer === "transportation") {
        capa.paint["line-color"] = id.includes("casing") ? colores.fondo : colores.calles;
        continue;
      }

      if (capa.type === "symbol") {
        const esNombreDeCalle = sourceLayer === "transportation_name";
        capa.paint["text-color"] = esNombreDeCalle
          ? colores.textoCalles
          : colores.textoSecundario;
        capa.paint["text-halo-color"] = esNombreDeCalle
          ? colores.calles
          : colores.fondo;
        capa.paint["text-halo-width"] = esNombreDeCalle ? 1.2 : 1.5;
      }
    }

    return estilo;
  }

  function mostrarRespaldo(contenedor: HTMLElement) {
    contenedor.innerHTML = `
      <div class="mapa-respaldo">
        <p>No pudimos cargar el mapa.</p>
        <a href="${COMO_LLEGAR_URL}" target="_blank" rel="noopener noreferrer">
          Ver ubicación en Google Maps ↗
        </a>
      </div>
    `;
  }

  function crearMarcador() {
    const marcador = document.createElement("div");
    marcador.className = "marcador-iglesia";
    marcador.innerHTML = `
      <svg width="38" height="48" viewBox="0 0 38 48" fill="none" aria-hidden="true">
        <path d="M19 1C9.1 1 1 9.1 1 19c0 13.1 18 28 18 28s18-14.9 18-28C37 9.1 28.9 1 19 1z"
          fill="var(--raw-accent)" stroke="var(--raw-bg)" stroke-width="2" />
        <circle cx="19" cy="19" r="6" fill="var(--raw-bg)" stroke="var(--raw-bg)" stroke-width="2" />
      </svg>
    `;
    return marcador;
  }

  let limpiar: (() => void) | null = null;

  async function crearMapa(contenedor: HTMLElement) {
    const esquema = window.matchMedia("(prefers-color-scheme: dark)");
    const obtenerTema = () => TEMAS[esquema.matches ? "oscuro" : "claro"];
    let base;
    try {
      base = await obtenerEstiloBase();
    } catch (error) {
      console.error("[Mapa] No se pudo cargar el estilo del mapa:", error);
      mostrarRespaldo(contenedor);
      return;
    }

    if (!contenedor.isConnected) return;

    const mapa = new maplibregl.Map({
      container: contenedor,
      style: aplicarColores(base, obtenerTema()),
      center: [UBICACION.lng, UBICACION.lat],
      zoom: 16,
      pitch: 0,
      bearing: 0,
      attributionControl: false,
      cooperativeGestures: true,
      locale: {
        "CooperativeGesturesHandler.WindowsHelpText": "Usa Ctrl + scroll para hacer zoom en el mapa",
        "CooperativeGesturesHandler.MacHelpText": "Usa ⌘ + scroll para hacer zoom en el mapa",
        "CooperativeGesturesHandler.MobileHelpText": "Usa dos dedos para mover el mapa",
        "NavigationControl.ZoomIn": "Acercar",
        "NavigationControl.ZoomOut": "Alejar",
      },
    });

    mapa.addControl(new maplibregl.NavigationControl({ showCompass: false }), "bottom-right");
    mapa.addControl(new maplibregl.AttributionControl({ compact: true }), "bottom-left");

    const popup = new maplibregl.Popup({ closeButton: false, maxWidth: "260px", className: "popup-cristo-viene" })
      .setHTML(`
        <div class="popup-contenido">
          <strong>Iglesia Cristo Viene</strong>
          <p>Cartago, Costa Rica</p>
          <a href="${COMO_LLEGAR_URL}" target="_blank" rel="noopener noreferrer">Cómo llegar ↗</a>
        </div>
      `);

    new maplibregl.Marker({ element: crearMarcador(), anchor: "bottom" })
      .setLngLat([UBICACION.lng, UBICACION.lat])
      .setPopup(popup)
      .addTo(mapa);

    const cambiarTema = () => mapa.setStyle(aplicarColores(base, obtenerTema()));
    esquema.addEventListener("change", cambiarTema);

    const observadorTamano = new ResizeObserver(() => mapa.resize());
    observadorTamano.observe(contenedor);
    limpiar = () => {
      observadorTamano.disconnect();
      esquema.removeEventListener("change", cambiarTema);
      mapa.remove();
    };
  }

  function iniciarMapa() {
    const contenedor = document.getElementById("mapa-cristo-viene");
    if (!contenedor || contenedor.dataset.iniciado) return;
    contenedor.dataset.iniciado = "true";

    const observador = new IntersectionObserver(([entrada]) => {
      if (!entrada.isIntersecting) return;
      observador.disconnect();
      crearMapa(contenedor);
    }, { rootMargin: "300px" });
    observador.observe(contenedor);
    limpiar = () => observador.disconnect();
  }

  document.addEventListener("astro:page-load", iniciarMapa);
  document.addEventListener("astro:before-swap", () => {
    limpiar?.();
    limpiar = null;
  });
  iniciarMapa();
</script>

<style is:global>
  .mapa-wrapper {
    width: 100%;
    height: 100%;
    min-height: var(--mapa-alto-min, 400px);
    border-radius: 20px;
    overflow: hidden;
    background: var(--raw-bg-block);
  }

  #mapa-cristo-viene {
    width: 100%;
    height: 100%;
    min-height: var(--mapa-alto-min, 400px);
  }

  .mapa-respaldo {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 100%;
    min-height: var(--mapa-alto-min, 400px);
    color: var(--raw-text-secondary);
    font-size: 14px;
    text-align: center;
  }

  .mapa-respaldo a { color: var(--raw-accent); font-weight: 700; }
  .mapa-wrapper .marcador-iglesia { cursor: pointer; }
  .mapa-wrapper .marcador-iglesia svg {
    display: block;
    overflow: visible;
    filter: drop-shadow(0 4px 8px rgb(0 0 0 / 0.45));
    transition: transform 0.2s ease;
  }
  .mapa-wrapper .marcador-iglesia:hover svg { transform: scale(1.08); }

  .mapa-wrapper .maplibregl-popup-content {
    background: var(--raw-bg-block-secondary);
    color: var(--raw-text-primary);
    border: 1px solid color-mix(in srgb, var(--raw-text-secondary) 35%, transparent);
    border-radius: 12px;
    padding: 16px 20px;
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.35);
  }
  .mapa-wrapper .maplibregl-popup-anchor-top .maplibregl-popup-tip,
  .mapa-wrapper .maplibregl-popup-anchor-top-left .maplibregl-popup-tip,
  .mapa-wrapper .maplibregl-popup-anchor-top-right .maplibregl-popup-tip {
    border-bottom-color: var(--raw-bg-block-secondary);
  }
  .mapa-wrapper .maplibregl-popup-anchor-bottom .maplibregl-popup-tip,
  .mapa-wrapper .maplibregl-popup-anchor-bottom-left .maplibregl-popup-tip,
  .mapa-wrapper .maplibregl-popup-anchor-bottom-right .maplibregl-popup-tip {
    border-top-color: var(--raw-bg-block-secondary);
  }
  .mapa-wrapper .maplibregl-popup-anchor-left .maplibregl-popup-tip { border-right-color: var(--raw-bg-block-secondary); }
  .mapa-wrapper .maplibregl-popup-anchor-right .maplibregl-popup-tip { border-left-color: var(--raw-bg-block-secondary); }
  .popup-contenido { font-family: "Aller", Arial, sans-serif; }
  .popup-contenido strong { font-size: 15px; font-weight: 700; }
  .popup-contenido p { color: var(--raw-text-secondary); font-size: 13px; margin: 6px 0 12px; }
  .popup-contenido a { color: var(--raw-accent); text-decoration: none; font-size: 13px; font-weight: 700; }

  .mapa-wrapper .maplibregl-ctrl-group {
    background: var(--raw-bg-block-secondary);
    border: 1px solid color-mix(in srgb, var(--raw-text-secondary) 35%, transparent);
    border-radius: 10px;
    box-shadow: none;
    overflow: hidden;
  }
  .mapa-wrapper .maplibregl-ctrl-group button { background-color: var(--raw-bg-block-secondary); }
  .mapa-wrapper .maplibregl-ctrl-group button + button { border-top: 1px solid color-mix(in srgb, var(--raw-text-secondary) 30%, transparent); }
  .mapa-wrapper .maplibregl-ctrl-attrib.maplibregl-compact {
    background: color-mix(in srgb, var(--raw-bg-block-secondary) 90%, transparent);
    border-radius: 10px;
    color: var(--raw-text-secondary);
  }
  .mapa-wrapper .maplibregl-ctrl-attrib a { color: var(--raw-text-secondary); }

  @media (prefers-color-scheme: dark) {
    .mapa-wrapper .maplibregl-ctrl-group button .maplibregl-ctrl-icon,
    .mapa-wrapper .maplibregl-ctrl-attrib-button { filter: invert(1); }
  }
</style>
