---
---

<section id="inicio" class="relative pt-40 pb-24 md:pt-52 md:pb-32 px-6">
  <div class="mx-auto max-w-4xl text-center">
    <p data-hero-item class="text-eyebrow uppercase tracking-[0.3em] text-text-secondary mb-5">
      Bienvenido a Cristo Viene
    </p>
    <h1 data-hero-item class="text-hero font-bold tracking-tight text-balance">
      Trabajamos para dar a conocer a Jesús y enseñar la vida que
      <span class="text-accent"> Él</span> quiere que vivamos
    </h1>
    <p data-hero-item class="mt-7 text-body-lg text-text-secondary max-w-xl mx-auto text-balance">
      Nuestro propósito consiste en contestar la pregunta:
      ¿Para qué existimos, y para qué hacemos lo que hacemos?
    </p>

    <div data-hero-item class="mt-9 flex flex-wrap items-center justify-center gap-4">
      <a
        href="#conocenos"
        class="rounded-full bg-bg-block-secondary px-8 py-3.5 text-body font-medium text-text-primary transition-transform hover:scale-[1.03]"
      >
        Conócenos
      </a>
      <a
        href="#eventos"
        class="rounded-full border border-text-secondary/50 px-8 py-3.5 text-body font-medium text-text-primary transition-colors hover:border-accent hover:text-accent"
      >
        Ver eventos
      </a>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";

  document.addEventListener("astro:page-load", () => {
    if (!document.querySelector("[data-hero-item]")) return;

    gsap.from("[data-hero-item]", {
      y: 28,
      opacity: 0,
      duration: 0.9,
      ease: "power3.out",
      stagger: 0.12,
      delay: 0.15,
    });
  });
</script>
